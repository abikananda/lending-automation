/**********************************************************************
 * Filling Fast Loans
 **********************************************************************/

rule "Filling Fast Lenders"
when
    $b : Borrower(
        borrowerType == "SALARIED",
        creditScore >= 600,
        lendenScore >= 700,
        income >= 25000,
        interestRate >= 18,
        age >= 18 && age <= 60,
        loanAmount <= 50000,
        tenure >= 1 && tenure <= 12,
        eval((loanAmount * 1.0 / income) <= 0.40),
        eval((loanAmount * 1.0 / tenure) <= income * 0.30),
        eval((income - (loanAmount * 1.0 / tenure)) >= 15000)
    )
then
    $b.setLendingAmount(250);
    logger.info("LENDING_DECISION: Filling Fast Lenders | amount=250 | risk=HIGH");
end


/**********************************************************************
 * Daily Repayment Loans
 **********************************************************************/

rule "Daily Repayment Lenders"
when
    $b : Borrower(
        creditScore >= 730,
        lendenScore >= 770,
        income >= 50000,
        interestRate >= 15 && interestRate <= 40,
        age >= 25 && age <= 60,
        loanAmount <= 100000,
        tenure >= 1 && tenure <= 12,
        eval((loanAmount * 1.0 / income) <= 1.0),
        eval((loanAmount * 1.0 / tenure) <= income * 0.20)
    )
then
    $b.setLendingAmount(2000);
    logger.info("LENDING_DECISION: Daily Repayment Lenders | amount=2000 | risk=MEDIUM");
end

