/**********************************************************************
 * General Salaried Borrowers
 **********************************************************************/

rule "Good Lenders"
when
    $b : Borrower(
        borrowerType == "SALARIED",
        creditScore >= 680,
        lendenScore >= 750,
        income >= 30000,
        interestRate >= 18,
        age >= 23 && age <= 55,
        loanAmount <= 30000,
        tenure >= 1 && tenure <= 6,
        eval((loanAmount * 1.0 / income) <= 0.30),
        eval((loanAmount * 1.0 / tenure) <= income * 0.20)
    )
then
    $b.setLendingAmount(1000);
    logger.info("LENDING_DECISION: Good Lenders | amount=1000 | risk=LOW-MED");
end


