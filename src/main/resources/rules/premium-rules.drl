package rules

import com.abika.model.Borrower;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Risk Optimization Strategy:
 * - All rules validate tenure (min 1, max 12 months - platform maximum)
 * - Debt-to-income ratios strictly enforce borrower safety
 * - Age and credit score thresholds prioritize borrower maturity
 * - Null/boundary checks prevent runtime errors
 * - Logging via SLF4J for production compliance
 */

global Logger logger;

/**********************************************************************
 * Repeated Borrowers
 **********************************************************************/

rule "Repeated Lenders - Low Risk"
when
    $b : Borrower(
        repeated,
        borrowerType == "SALARIED",
        creditScore >= 730,
        lendenScore >= 770,
        income >= 80000,
        interestRate >= 18 && interestRate <= 48,
        age >= 25 && age <= 55,
        loanAmount <= 30000,
        tenure >= 1 && tenure <= 4,
        eval((loanAmount * 1.0 / income) <= 0.30),
        eval((loanAmount * 1.0 / tenure) <= income * 0.20)
    )
then
    $b.setLendingAmount(4000);
    logger.info("LENDING_DECISION: Repeated Lenders - Low Risk | amount=4000 | risk=LOW");
end


rule "Repeated Lenders - Medium Risk"
when
    $b : Borrower(
        repeated,
        borrowerType == "SALARIED",
        creditScore >= 700,
        lendenScore >= 750,
        income >= 50000,
        interestRate >= 18 && interestRate <= 48,
        age >= 20 && age <= 55,
        loanAmount <= 50000,
        tenure >= 1 && tenure <= 6,
        eval((loanAmount * 1.0 / income) <= 0.40),
        eval((loanAmount * 1.0 / tenure) <= income * 0.20)
    )
then
    $b.setLendingAmount(2000);
    logger.info("LENDING_DECISION: Repeated Lenders - Medium Risk | amount=2000 | risk=MEDIUM");
end


rule "Repeated Lenders - High Risk"
when
    $b : Borrower(
        repeated,
        borrowerType == "SALARIED",
        creditScore >= 600,
        lendenScore >= 700,
        income >= 25000,
        interestRate >= 18,
        age >= 18 && age <= 60,
        loanAmount <= 100000,
        tenure >= 1 && tenure <= 12,
        eval((loanAmount * 1.0 / income) <= 0.50),
        eval((loanAmount * 1.0 / tenure) <= income * 0.40)
    )
then
    $b.setLendingAmount(1000);
    logger.info("LENDING_DECISION: Repeated Lenders - High Risk | amount=1000 | risk=HIGH");
end


